    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <key>StandardOutPath</key>
    <string>/Users/sirinx/.hermes/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sirinx/.hermes/logs/dashboard.error.log</string>
