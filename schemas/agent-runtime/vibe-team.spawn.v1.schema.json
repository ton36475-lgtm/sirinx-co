{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.co/schemas/agent-runtime/vibe-team.spawn.v1.schema.json",
  "title": "SIRINX vibe-team spawn plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "authority",
    "references",
    "lanes",
    "teamShapes",
    "limits",
    "modelRouting",
    "stopRules"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "PLAN_ONLY / LIVE_ADAPTERS_NOT_ACTIVATED" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloneReferenceRepos",
        "installReferenceRepos",
        "providerCall",
        "queueMutation",
        "liveSend",
        "runtimeSpawn"
      ],
      "properties": {
        "cloneReferenceRepos": { "const": false },
        "installReferenceRepos": { "const": false },
        "providerCall": { "const": false },
        "queueMutation": { "const": false },
        "liveSend": { "const": false },
        "runtimeSpawn": { "const": false }
      }
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId",
        "displayName",
        "catalogSource",
        "catalogVerified",
        "accessVerified",
        "liveCallsAllowed",
        "appliesToLanes",
        "notes"
      ],
      "properties": {
        "provider": { "const": "freebuff" },
        "modelId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "catalogSource": { "const": "infra/9router/model-catalog.json" },
        "catalogVerified": { "const": true },
        "accessVerified": { "const": false },
        "liveCallsAllowed": { "const": false },
        "appliesToLanes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cline", "manus", "cue"] }
        },
        "notes": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "references": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceId",
          "publisher",
          "sourceUrl",
          "license",
          "status",
          "architecture",
          "adoptedPattern",
          "notAdopted",
          "runtimeState"
        ],
        "properties": {
          "referenceId": { "enum": ["openbot", "openmanus", "opendots"] },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
          "sourceUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "license": { "const": "MIT" },
          "status": { "type": "string", "minLength": 1, "maxLength": 40 },
          "architecture": { "type": "string", "minLength": 1, "maxLength": 512 },
          "adoptedPattern": { "type": "string", "minLength": 1, "maxLength": 256 },
          "notAdopted": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "runtimeState": { "const": "DOCS_READ_ONLY_NOT_CLONED" }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "laneId",
          "kind",
          "entrypoint",
          "baseUrl",
          "endpoints",
          "authHeader",
          "activation",
          "requiredTickets",
          "liveCallsAllowed",
          "agentProfiles",
          "notes"
        ],
        "properties": {
          "laneId": { "enum": ["cline", "manus", "cue"] },
          "kind": { "enum": ["local-cli", "hosted-api", "app-only"] },
          "entrypoint": { "type": ["string", "null"], "maxLength": 64 },
          "versionFloor": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "headlessFlag": { "type": "string", "pattern": "^--[a-z-]+$" },
          "baseUrl": { "type": ["string", "null"], "pattern": "^https://[A-Za-z0-9.-]+$" },
          "endpoints": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "pattern": "^/v[0-9]+/[A-Za-z0-9._-]+$" }
          },
          "authHeader": { "type": ["string", "null"], "pattern": "^x-[a-z-]+$" },
          "activation": { "type": "string", "minLength": 1, "maxLength": 64 },
          "requiredTickets": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["PROVIDER_CALL", "LIVE_SEND", "QUEUE_MUTATION", "INSTALL"] }
          },
          "liveCallsAllowed": { "const": false },
          "agentProfiles": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "enum": [
                "standard",
                "lite",
                "max",
                "max-medium",
                "max-high",
                "max-extra",
                "max-ultra"
              ]
            }
          },
          "notes": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "teamShapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shapeId", "archetype", "maxWorkers", "roles"],
        "properties": {
          "shapeId": { "enum": ["research", "implementation", "persistent-ops"] },
          "archetype": {
            "enum": [
              "openbot-coworker",
              "openmanus-planner-executor",
              "opendots-persistent-dot"
            ]
          },
          "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 3 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roleId", "duty", "lane"],
              "properties": {
                "roleId": {
                  "type": "string",
                  "pattern": "^(L[1-5]-[0-9]{2}|Kai)$"
                },
                "duty": { "type": "string", "minLength": 1, "maxLength": 64 },
                "lane": { "enum": ["cline", "manus", "cue"] }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWorkers",
        "maxPacketsPerWave",
        "maxSteps",
        "maxTokens",
        "maxCostMicroUsd",
        "timeoutSeconds"
      ],
      "properties": {
        "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxPacketsPerWave": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 200000 },
        "maxCostMicroUsd": { "type": "integer", "minimum": 0, "maximum": 0 },
        "timeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 }
      }
    },
    "stopRules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
