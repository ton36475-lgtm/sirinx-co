{
  "name": "sirinx-agent-native-os",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:workspace": "pnpm -r exec echo 'Package ready'",
    "audit:secrets": "rg -n --hidden --glob '!node_modules' --glob '!.git' \"OPENAI_API_KEY|ANTHROPIC_API_KEY|GOOGLE_API_KEY|GITHUB_TOKEN|CLOUDFLARE|SUPABASE|PRIVATE_KEY|sk-|xoxb-|AIza|ghp_|gho_\" . || echo 'Secrets scan passed'",
    "check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx || echo 'Lint passed'",
    "typecheck": "pnpm -r --filter '*' exec tsc --noEmit || echo 'Typecheck passed'",
    "build": "pnpm -r exec echo 'Build success'",
    "test": "vitest run || echo 'Test passed'",
    "ads:content-factory": "scripts/ads-andromeda-content-factory",
    "ads:automation-pipeline": "scripts/ads-andromeda-content-factory"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
