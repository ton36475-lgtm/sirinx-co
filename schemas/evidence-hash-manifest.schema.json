{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/evidence-hash-manifest.schema.json",
  "title": "SIRINX Evidence Hash Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at",
    "tool",
    "root",
    "algorithm",
    "proof_status",
    "summary",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "implementation": {
          "type": "string",
          "enum": ["spec", "rust-cli", "wasm", "shell-baseline"]
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path"],
      "properties": {
        "relative_path": { "type": "string" },
        "absolute_path": { "type": "string" }
      }
    },
    "algorithm": {
      "type": "string",
      "enum": ["sha256"]
    },
    "proof_status": {
      "$ref": "proof-status.schema.json"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes"],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ignored_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "git_object_id": { "type": "string" },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          },
          "mime_type": { "type": "string" }
        }
      }
    },
    "ignored": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  }
}
