{
  "info": {
    "_postman_id": "d4bcf2f1-2dd3-4d26-9a7b-5ccf145e7712",
    "name": "SIRINX Proposal Prototype — Local Mock Only",
    "description": "Postman collection for the loopback-only mock server. No production URL, auth, real data, LLM, device command, lead creation, persistence or external integration is included. Includes a BESS-only assessment preview using non-identifying fields; no real lead, size or ROI is produced.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8766/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Status / boundary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('mock boundary is explicit', function () {",
              "  const j = pm.response.json();",
              "  pm.expect(j.demoOnly).to.eql(true);",
              "  pm.expect(j.liveIntegrations).to.eql(false);",
              "  pm.expect(j.persisted).to.eql(false);",
              "  pm.expect(j.deviceCommands).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
