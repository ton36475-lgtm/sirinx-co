# SIRINX OS worker env — placeholder names and non-secret defaults only.
#
# Copy to ~/.config/sirinx/sirinx.env, mode 600, and fill values locally:
#   mkdir -p ~/.config/sirinx
#   install -m 600 ~/.config/sirinx/sirinx.env.example ~/.config/sirinx/sirinx.env
#
# Never commit that file, never paste it into chat, never copy it into the repo.
# `apply.sh` writes only this example; it never creates or reads a filled .env.

SIRINX_ENV=worker
SIRINX_REPO=$HOME/SIRINXDev/sirinx-co

# Control plane (Mac mini M2) over the tailnet. Non-secret: the address is
# already documented in docs/TAILNET_MESH_WORKFLOW_PLAN_20261020.md.
SIRINX_CONTROL_URL=http://100.90.189.112:8790

# A2A identity for this node. The endpoint needs this node's own tailnet IP,
# which only exists after the tailnet join (MASTER_PLAN C6).
A2A_NODE_ID=omarchy-aiagent
A2A_ENDPOINT=

# Set these only in the 600 file, never here and never in the repo.
CONTROL_API_TOKEN=
NODE_HEARTBEAT_SHARED_SECRET=
DATABASE_URL=
REDIS_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
