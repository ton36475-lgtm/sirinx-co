{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/public-web/egress.allowlist.v1.schema.json",
  "title": "SIRINX public-web egress allowlist v1",
  "description": "Every literal host in the public-web source surface, with the class that decides whether a browser fetch or an operator waiver is required. Consumed by scripts/verify-public-web-egress.mjs, which owns the fetch/waiver policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schema", "updated", "notes", "hosts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "schema": { "const": "public-web.egress.allowlist.v1" },
    "updated": { "type": "string", "format": "date" },
    "notes": { "type": "string", "minLength": 1 },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "class", "reason"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.*-]*(\\.[a-z0-9-]+)*$"
        },
        "class": {
          "enum": [
            "own-origin",
            "own-infra",
            "service-api",
            "third-party-asset",
            "third-party-font",
            "navigation-link",
            "vocabulary",
            "local-dev",
            "documentation",
            "upstream-reference",
            "template-scaffold"
          ]
        },
        "subdomains": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticket", "until", "detail"],
          "properties": {
            "ticket": { "type": "string", "minLength": 1 },
            "until": { "type": "string", "format": "date" },
            "detail": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
