{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/product-design-artifact.schema.json",
  "title": "SIRINX Product Design Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "project",
    "feature",
    "created_at",
    "proof_status",
    "source",
    "screens",
    "design_system",
    "handoff"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^pd-[0-9]{8}-[a-z0-9-]+$"
    },
    "project": { "type": "string" },
    "feature": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "proof_status": {
      "$ref": "proof-status.schema.json"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_file", "brief"],
      "properties": {
        "prompt_file": { "type": "string" },
        "brief": { "type": "string" },
        "screenshot_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "states": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "components"],
      "properties": {
        "tokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "theme": { "type": "string" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_path", "task_path", "approval_required"],
      "properties": {
        "spec_path": { "type": "string" },
        "task_path": { "type": "string" },
        "approval_required": { "type": "boolean" }
      }
    }
  }
}
