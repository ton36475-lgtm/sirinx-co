{
  "_comment": "SIRINX Solar Energy — Cloudflare Cache Rules Strategy",
  "_note": "Import these rules via Cloudflare API or configure manually in Dashboard → Rules → Cache Rules",

  "zone": "sirinx.com",
  "rules": [
    {
      "name": "Static Assets — Cache 30 Days",
      "description": "Next.js static files, fonts, icons — immutable hashed filenames",
      "expression": "(http.request.uri.path matches \"^/_next/static/\") or (http.request.uri.path matches \"^/static/\") or (http.request.uri.path matches \"\\.(woff2?|ttf|eot|ico|svg)$\")",
      "cache": {
        "enabled": true,
        "browser_ttl": 2592000,
        "edge_ttl": 2592000,
        "cache_level": "cache_everything",
        "respect_strong_etags": true
      },
      "priority": 1
    },
    {
      "name": "Images — Cache 30 Days",
      "description": "All image files including optimized images from CDN",
      "expression": "(http.request.uri.path matches \"\\.(jpg|jpeg|png|gif|webp|avif|bmp)$\") or (http.request.uri.path matches \"^/img\")",
      "cache": {
        "enabled": true,
        "browser_ttl": 2592000,
        "edge_ttl": 2592000,
        "cache_level": "cache_everything",
        "serve_stale": true
      },
      "priority": 2
    },
    {
      "name": "SEO Province Pages — Cache 1 Hour",
      "description": "Landing pages for 77 Thai provinces — regenerated by Worker KV",
      "expression": "http.request.uri.path matches \"^/solar/\"",
      "cache": {
        "enabled": true,
        "browser_ttl": 3600,
        "edge_ttl": 3600,
        "cache_level": "cache_everything",
        "serve_stale": true
      },
      "priority": 3
    },
    {
      "name": "Sitemap — Cache 24 Hours",
      "description": "XML sitemap — updated infrequently",
      "expression": "http.request.uri.path eq \"/sitemap.xml\"",
      "cache": {
        "enabled": true,
        "browser_ttl": 86400,
        "edge_ttl": 86400,
        "cache_level": "cache_everything"
      },
      "priority": 4
    },
    {
      "name": "API Responses — Cache 5 Minutes",
      "description": "Public API endpoints that return non-user-specific data",
      "expression": "(http.request.uri.path matches \"^/api/public/\") or (http.request.uri.path matches \"^/api/models\") or (http.request.uri.path matches \"^/api/provinces\")",
      "cache": {
        "enabled": true,
        "browser_ttl": 0,
        "edge_ttl": 300,
        "cache_level": "cache_everything",
        "bypass_on_cookie": "sirinx_session"
      },
      "priority": 5
    },
    {
      "name": "API Auth/Private — Bypass Cache",
      "description": "Authenticated API endpoints — never cache",
      "expression": "(http.request.uri.path matches \"^/api/\") and (http.request.method in {\"POST\" \"PUT\" \"PATCH\" \"DELETE\"})",
      "cache": {
        "enabled": false,
        "cache_level": "bypass"
      },
      "priority": 6
    },
    {
      "name": "Dashboard Pages — Bypass Cache",
      "description": "Authenticated app pages — always fresh",
      "expression": "(http.request.uri.path matches \"^/dashboard\") or (http.request.uri.path matches \"^/settings\") or (http.request.uri.path matches \"^/leads\") or (http.request.uri.path matches \"^/agents\")",
      "cache": {
        "enabled": false,
        "cache_level": "bypass"
      },
      "priority": 7
    },
    {
      "name": "Homepage — Cache 10 Minutes",
      "description": "Marketing homepage — short TTL for quick updates",
      "expression": "http.request.uri.path eq \"/\"",
      "cache": {
        "enabled": true,
        "browser_ttl": 600,
        "edge_ttl": 600,
        "cache_level": "cache_everything"
      },
      "priority": 8
    }
  ],

  "summary": {
    "static_assets": "30 days (/_next/static/*, fonts, icons)",
    "images": "30 days (/img*, .jpg, .webp, etc.)",
    "seo_pages": "1 hour (/solar/*)",
    "sitemap": "24 hours (/sitemap.xml)",
    "api_public": "5 minutes (/api/public/*, /api/models)",
    "api_private": "bypass (POST/PUT/PATCH/DELETE)",
    "dashboard": "bypass (/dashboard, /settings, /leads)",
    "homepage": "10 minutes (/)"
  }
}
