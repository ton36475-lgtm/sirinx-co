{
  "agent_id": "codex-local",
  "name": "Codex Local Repo Executor",
  "role": "current-session-repo-execution-worker",
  "model_profile": "active-codex-session",
  "runtime": "codex-desktop-or-local-cli",
  "capabilities": [
    "repo_inspection",
    "file_generation",
    "code_editing",
    "patch_generation",
    "test_running",
    "docs_update",
    "script_generation",
    "integration_scaffold",
    "diff_summary",
    "local_validation"
  ],
  "default_tasks": ["inspect", "edit", "test", "report"],
  "local_only": true,
  "blocked_actions": [
    "print_secret",
    "force_push",
    "public_endpoint",
    "deploy_without_policy",
    "read_secret_files",
    "route_repo_execution_through_kob_hosted_codex",
    "mutate_unscoped_dirty_lanes"
  ]
}
