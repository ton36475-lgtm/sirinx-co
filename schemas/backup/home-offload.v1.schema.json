{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/backup/home-offload.v1.schema.json",
  "title": "SIRINX home offload plan v1",
  "description": "Split-home offload plan consumed by scripts/home-offload.mjs. Copy-only: no set is ever synced with --delete, and localOnly sets never leave the Mac mini.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "status", "home", "targets", "excludes", "sets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date" },
    "status": { "const": "plan-only" },
    "home": { "const": "~" },
    "note": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usb", "icloud"],
      "properties": {
        "usb": { "$ref": "#/$defs/target" },
        "icloud": { "$ref": "#/$defs/target" }
      }
    },
    "excludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/set" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "root"],
      "properties": {
        "volume": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "glob": { "type": "string", "minLength": 1 },
        "filesOnly": { "type": "boolean" },
        "skipExtensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" }
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "oneOf": [{ "required": ["path"] }, { "required": ["glob"] }]
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "localOnly": { "type": "boolean" },
        "repoRelative": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    }
  }
}
