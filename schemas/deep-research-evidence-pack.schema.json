{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirinx.local/schemas/deep-research-evidence-pack.schema.json",
  "title": "Sovereign Deep Research Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "generated_at",
    "evidence_units",
    "source_quality_records",
    "claim_verification_records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^DR-[0-9]{8}-[0-9]{3}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_unit" }
    },
    "source_quality_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_quality_record" }
    },
    "claim_verification_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_verification_record" }
    }
  },
  "$defs": {
    "evidence_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "job_id",
        "source_id",
        "source_type",
        "source_uri",
        "capture_time",
        "modality",
        "raw_text",
        "claim_type",
        "confidence",
        "review_state"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev_[a-z0-9_\\-]+$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^DR-[0-9]{8}-[0-9]{3}$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^src_[a-z0-9_\\-]+$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "video",
            "transcript",
            "pdf",
            "screenshot",
            "url",
            "table",
            "note"
          ]
        },
        "source_uri": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        },
        "capture_time": {
          "type": "string",
          "format": "date-time"
        },
        "timestamp_start": {
          "type": ["string", "null"]
        },
        "timestamp_end": {
          "type": ["string", "null"]
        },
        "page_number": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "bbox": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "modality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "speech",
              "visual",
              "ocr",
              "text",
              "table",
              "chart",
              "metadata"
            ]
          },
          "uniqueItems": true
        },
        "raw_text": {
          "type": "string"
        },
        "normalized_claim": {
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/claim_type"
        },
        "visual_context": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extraction_method": {
          "type": "string"
        },
        "review_state": {
          "type": "string",
          "enum": [
            "draft",
            "needs_verification",
            "verified",
            "conflict_found",
            "quarantined",
            "accepted_for_report"
          ]
        }
      }
    },
    "source_quality_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_class",
        "authority_score",
        "recency_score",
        "directness_score",
        "transparency_score",
        "bias_penalty"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[a-z0-9_\\-]+$"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "published_at": {
          "type": ["string", "null"]
        },
        "source_class": {
          "type": "string",
          "enum": [
            "academic",
            "government",
            "standards",
            "industry_report",
            "vendor_datasheet",
            "market_page",
            "news",
            "social",
            "internal_note",
            "unknown"
          ]
        },
        "authority_score": { "$ref": "#/$defs/score" },
        "recency_score": { "$ref": "#/$defs/score" },
        "directness_score": { "$ref": "#/$defs/score" },
        "transparency_score": { "$ref": "#/$defs/score" },
        "bias_penalty": { "$ref": "#/$defs/score" },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim_verification_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "claim_type",
        "source_evidence_ids",
        "external_evidence_ids",
        "status",
        "confidence",
        "assumptions",
        "conflicts",
        "recommendation"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim_[a-z0-9_\\-]+$"
        },
        "claim_text": {
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/claim_type"
        },
        "source_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[a-z0-9_\\-]+$" }
        },
        "external_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev_[a-z0-9_\\-]+$" }
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "partially_supported",
            "contradicted",
            "unverified",
            "out_of_scope"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unverified"]
        },
        "base_case": {
          "type": "string"
        },
        "aggressive_case": {
          "type": "string"
        },
        "worst_case": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendation": {
          "type": "string"
        }
      }
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "technical",
        "financial",
        "market",
        "regulatory",
        "operational",
        "strategic",
        "speculative"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
