{
  "info": {
    "_postman_id": "0479fc41-cf86-41db-b210-c2c9ad275acf",
    "name": "SIRINX Agent Mesh - Local Dry Run",
    "description": "Strictly loopback-only readiness, read, pure-compute, and explicit dry-run requests for the local SIRINX agent mesh. The collection never starts services and contains no mutation request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseKeys = ['web_base_url', 'rust_control_base_url', 'node_control_base_url', 'brain_base_url'];",
          "const basePattern = /^http:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d+)?$/i;",
          "const requestPattern = /^http:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d+)?(?:\\/|$)/i;",
          "const unsafeBases = baseKeys.filter((key) => !basePattern.test(String(pm.environment.get(key) || '')));",
          "const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "if (unsafeBases.length > 0 || !requestPattern.test(resolvedUrl)) {",
          "  console.error('SIRINX local guard skipped a non-loopback or incomplete request.');",
          "  pm.execution.skipRequest();",
          "}",
          "pm.request.headers.remove('Authorization');",
          "const authTargets = [",
          "  ['rust_control_base_url', 'control_token'],",
          "  ['brain_base_url', 'brain_token']",
          "];",
          "authTargets.forEach(([baseKey, tokenKey]) => {",
          "  const base = String(pm.environment.get(baseKey) || '');",
          "  const token = String(pm.environment.get(tokenKey) || '');",
          "  if (base && token && (resolvedUrl === base || resolvedUrl.startsWith(base + '/'))) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "  }",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is successful', () => pm.expect(pm.response.code).to.be.within(200, 299));",
          "let responseBody = null;",
          "try { responseBody = pm.response.json(); } catch (_) {}",
          "pm.test('Response is JSON object', () => {",
          "  pm.expect(String(pm.response.headers.get('content-type') || '')).to.match(/^application\\/json\\b/i);",
          "  pm.expect(responseBody).to.be.an('object').and.not.equal(null);",
          "});",
          "const baseKeys = ['web_base_url', 'rust_control_base_url', 'node_control_base_url', 'brain_base_url'];",
          "const loopbackBase = /^http:\\/\\/(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d+)?$/i;",
          "pm.test('All base URLs are loopback-only', () => {",
          "  baseKeys.forEach((key) => pm.expect(String(pm.environment.get(key) || ''), key).to.match(loopbackBase));",
          "});",
          "const secretBearingKeys = new Set([",
          "  'password', 'passwd', 'token', 'accesstoken', 'refreshtoken', 'apikey',",
          "  'secret', 'clientsecret', 'privatekey', 'authorization', 'cookie', 'setcookie'",
          "]);",
          "const mustRemainFalse = new Set([",
          "  'externalwrites', 'cancallprovider', 'commandexecuted', 'providercalled',",
          "  'cancallpaidapi', 'canexecuteexternally', 'canreadsecrets', 'secretsread',",
          "  'keyvalueprinted', 'canrunmcp', 'canstartmcp', 'caninstallpackages',",
          "  'cansendmessages', 'candeploy', 'canpush', 'canpublish',",
          "  'canautostartagents', 'canmodifysource', 'canexecutenow',",
          "  'canstartgateways', 'canstarthermesteam', 'canrunantigravitycli'",
          "]);",
          "const exposedSecretFields = [];",
          "const unsafeFlags = [];",
          "function inspect(value, path) {",
          "  if (Array.isArray(value)) { value.forEach((entry, index) => inspect(entry, path + '[' + index + ']')); return; }",
          "  if (!value || typeof value !== 'object') return;",
          "  Object.keys(value).forEach((key) => {",
          "    const normalized = key.replace(/[-_]/g, '').toLowerCase();",
          "    const nextPath = path + '.' + key;",
          "    if (secretBearingKeys.has(normalized)) exposedSecretFields.push(nextPath);",
          "    if (mustRemainFalse.has(normalized) && value[key] !== false) unsafeFlags.push(nextPath + '=' + String(value[key]));",
          "    inspect(value[key], nextPath);",
          "  });",
          "}",
          "inspect(responseBody, '$');",
          "pm.test('Response has no secret-bearing fields', () => pm.expect(exposedSecretFields).to.eql([]));",
          "pm.test('Safety capability fields remain false when present', () => pm.expect(unsafeFlags).to.eql([]));"
        ]
      }
    }
  ],
