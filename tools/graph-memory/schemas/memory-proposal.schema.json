{
  "$id": "https://sirinx.local/schemas/memory-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$",
      "title": "Agent Id",
      "type": "string"
    },
    "project": {
      "const": "sirinx-co",
      "title": "Project",
      "type": "string"
    },
    "summary": {
      "maxLength": 500,
      "minLength": 8,
      "title": "Summary",
      "type": "string"
    },
    "proposed_memory": {
      "maxLength": 4000,
      "minLength": 8,
      "title": "Proposed Memory",
      "type": "string"
    },
    "observations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Observations",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_class": {
      "enum": [
        "observed",
        "derived",
        "inferred",
        "reported",
        "unverified"
      ],
      "title": "Evidence Class",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,47}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "agent_id",
    "project",
    "summary",
    "proposed_memory",
    "observations",
    "evidence_refs",
    "evidence_class"
  ],
  "title": "SIRINX Memory Proposal",
  "type": "object"
}
