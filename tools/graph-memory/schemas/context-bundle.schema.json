{
  "$defs": {
    "CodeGraphSourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "graph_confidence": {
          "enum": [
            "EXTRACTED",
            "INFERRED",
            "AMBIGUOUS"
          ],
          "title": "Graph Confidence",
          "type": "string"
        },
        "graph_manifest_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Graph Manifest Sha256",
          "type": "string"
        },
        "graph_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "node_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "relation": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation"
        },
        "relative_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "repository_id": {
          "const": "sirinx-co",
          "title": "Repository Id",
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "base_sha",
        "graph_sha256",
        "graph_manifest_sha256",
        "node_id",
        "relative_path",
        "source_file_sha256",
        "graph_confidence"
      ],
      "title": "CodeGraphSourceRefV1",
      "type": "object"
    },
    "ContextItemV1": {
      "additionalProperties": false,
      "description": "One source-bound item whose identifier is derived from its digest.",
      "properties": {
        "authority": {
          "const": "context_only",
          "title": "Authority",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "observed",
            "derived",
            "inferred",
            "reported",
            "unverified"
          ],
          "title": "Evidence Class",
          "type": "string"
        },
        "item_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Item Digest",
          "type": "string"
        },
        "item_id": {
          "pattern": "^context-item-[0-9a-f]{24}$",
          "title": "Item Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "code_graph",
            "obsidian_projection"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeGraphSourceRefV1"
            },
            {
              "$ref": "#/$defs/ObsidianSourceRefV1"
            }
          ],
          "title": "Source Ref"
        },
        "text": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "item_id",
        "source_kind",
        "source_ref",
        "snapshot_digest",
        "content_digest",
        "item_digest",
        "evidence_class",
        "authority",
        "text"
      ],
      "title": "ContextItemV1",
      "type": "object"
    },
    "ObsidianSourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "chunks_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Chunks Sha256",
          "type": "string"
        },
        "display_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Path",
          "type": "string"
        },
        "path_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Path Digest",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        }
      },
      "required": [
        "snapshot_digest",
        "chunks_sha256",
        "chunk_id",
        "chunk_sha256",
        "path_digest",
        "display_path"
      ],
      "title": "ObsidianSourceRefV1",
      "type": "object"
    }
  },
  "$id": "https://sirinx.local/schemas/context-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded context handoff; never an authority or persistence record.",
  "properties": {
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Sha",
      "type": "string"
    },
    "bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "external_calls": {
      "const": 0,
      "title": "External Calls",
      "type": "integer"
    },
    "goal_spec_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Goal Spec Digest",
      "type": "string"
    },
    "graph_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graph Snapshot Digest",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ContextItemV1"
      },
      "maxItems": 16,
      "title": "Items",
      "type": "array"
    },
    "obsidian_snapshot_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Obsidian Snapshot Digest"
    },
    "provider_calls": {
      "const": 0,
      "title": "Provider Calls",
      "type": "integer"
    },
    "query_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Query Digest",
      "type": "string"
    },
    "repository_id": {
      "const": "sirinx-co",
      "title": "Repository Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "total_text_bytes": {
      "maximum": 24000,
      "minimum": 0,
      "title": "Total Text Bytes",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "goal_spec_digest",
    "repository_id",
    "base_sha",
    "graph_snapshot_digest",
    "query_digest",
    "items",
    "total_text_bytes",
    "provider_calls",
    "external_calls",
    "bundle_digest"
  ],
  "title": "SIRINX Context Bundle V1",
  "type": "object"
}
